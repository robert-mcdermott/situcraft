 "checks": [
  {
   "name": "cells",
   "tolerance": "SituCraft's within 5% of Proseg's",
   "value": 0.0023,
   "limit": 0.05,
   "pass": true
  },
  {
   "name": "assigned fraction",
   "tolerance": "within 3 points of Proseg's",
   "value": 0.0396,
   "limit": 0.03,
   "pass": false,
   "explained": "Proseg leaves more transcripts in no cell, but on the simulated tissue only 18% of those it leaves there are background: 1.42% of all transcripts are cells' it leaves out, against SituCraft's 0.13% (61% of the 0.34% it leaves out are background). A larger background share is not a more accurate one. On Lung (SituCraft 99.63%, Proseg 95.68%, the instrument 97.97%) the negative controls put the false decodes at 0.04% of the transcripts; the rest of any background is ambient RNA, which inside cells cannot be told from their own (research.md §3.2, the background)."
  },
  {
   "name": "spurious co-expression",
   "tolerance": "SituCraft's at most 10% above Proseg's",
   "value": 1.6781,
   "limit": 1.5061,
   "pass": false,
   "explained": "Spurious co-expression does not rank methods by accuracy: on the simulated tissue Proseg's (1.87) is below the truth's own (1.89) while it puts 75.2% of transcripts in their true cell, against SituCraft's 84.7% (2.02). On Lung SituCraft's is 10% below the instrument's; part of the rest is ambient RNA counted in cells (research.md §3.2, the background)."
  },
  {
   "name": "matched cells' counts",
   "tolerance": "SituCraft and Proseg correlated within 0.05 of the lower of their own runs' correlations",
   "value": 0.8389,
   "limit": 0.795,
   "pass": true
  },
  {
   "name": "median IoU",
   "tolerance": "SituCraft and Proseg within 0.10 of the lower of their own runs' median IoUs",
   "value": 0.5583,
   "limit": 0.5875,
   "pass": false,
   "explained": "Lung's cells are the smallest (median 37 µm²), and Proseg's outlines are more compact there (1.16 times the least perimeter, SituCraft's 1.32): with Conservative's bound (1.3) SituCraft's agreement with Proseg rises from 0.557 to 0.576. Starting SituCraft from the nuclei, as Proseg starts, leaves it at 0.557."
  }
