  {
   "name": "cells",
   "tolerance": "SituCraft's within 5% of Proseg's",
   "value": 0.0023,
   "limit": 0.05,
   "pass": true
  },
  {
   "name": "assigned fraction",
   "tolerance": "within 3 points of Proseg's",
   "value": 0.0395,
   "limit": 0.03,
   "pass": false,
   "explained": "SituCraft assigns to cells transcripts the background would explain. On the simulated tissue it assigns 99.95% where the truth assigns 97.54% (Proseg 98.47%): its background rate is a quarter of the truth's (0.68% of the transcripts against 2.46%), the same from any start, a property of one background rate per gene when cells cover nearly every transcript. Lung shows it most (SituCraft 99.63%, Proseg 95.68%, the instrument 97.97%)."
  },
  {
   "name": "spurious co-expression",
   "tolerance": "SituCraft's at most 10% above Proseg's",
   "value": 1.6786,
   "limit": 1.5061,
   "pass": false,
   "explained": "Spurious co-expression does not rank methods by accuracy: on the simulated tissue Proseg's (1.99) is below the truth's own (2.01) while it puts 75.6% of transcripts in their true cell, against SituCraft's 85.0% (2.14). On Lung SituCraft's is 10% below the instrument's; part of the rest is the background it assigns."
  },
  {
   "name": "matched cells' counts",
   "tolerance": "SituCraft and Proseg correlated within 0.05 of the lower of their own runs' correlations",
   "value": 0.8403,
   "limit": 0.795,
   "pass": true
  },
  {
   "name": "median IoU",
   "tolerance": "SituCraft and Proseg within 0.10 of the lower of their own runs' median IoUs",
   "value": 0.5574,
   "limit": 0.5882,
   "pass": false,
   "explained": "Lung's cells are the smallest (median 37 µm²), and Proseg's outlines are more compact there (1.16 times the least perimeter, SituCraft's 1.32): with Conservative's bound (1.3) SituCraft's agreement with Proseg rises from 0.557 to 0.576. Starting SituCraft from the nuclei, as Proseg starts, leaves it at 0.557."
  }
 ]
