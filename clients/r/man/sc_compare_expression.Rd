\name{sc_compare_expression}
\alias{sc_compare_expression}
\title{Compare the groups' expression}
\usage{
sc_compare_expression(design = NULL, level = NULL, min_cells = NULL, summary = NULL, sc = sc_default())
}
\arguments{
\item{design}{A saved design, by name (its latest version; the Cohort view's draft if not given). Optional; a string.}
\item{level}{The intervals' level (0.95 if not given). Optional; a number.}
\item{min_cells}{The fewest cells of a label a unit is tested with (10 if not given). Optional; a whole number.}
