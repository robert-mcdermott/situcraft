\name{sc_reference_labels}
\alias{sc_reference_labels}
\title{Label the cells from a reference}
\usage{
sc_reference_labels(clustering = NULL, dataset = NULL, gene_column = NULL, label_column = NULL, margin = NULL, markers = NULL, matrix = NULL, name_clusters = NULL, path = NULL, tune = NULL, sc = sc_default())
}
\arguments{
\item{clustering}{A clustering, by artifact id or name; SituCraft's latest if not given. Optional; a string.}
\item{dataset}{A dataset of the project by name or id; the one in focus, else the first, if not given. Optional; a string.}
\item{gene_column}{The var column of gene names (the index if not given; or, for a table of a row per gene, its genes' column). Optional; a string.}
